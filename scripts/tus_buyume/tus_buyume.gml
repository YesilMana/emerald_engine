function tus_buyume(temel_xscale, temel_yscale, mouse_girince_buyume, temel_konum_x, temel_konum_y, yer_degistirme){
			image_xscale = temel_xscale + mouse_girince_buyume;
			image_yscale = temel_yscale + mouse_girince_buyume;
			x = temel_konum_x - yer_degistirme;
			y = temel_konum_y - yer_degistirme;
}