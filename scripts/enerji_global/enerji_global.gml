function enerji_global(){
	//Enerji tanımlamaları
	global.karakter_enerji = 20; //Karakterin enerjisi başta kaç olacak (Dokunulması önerilmez)
	global.karakter_enerji_full = global.karakter_enerji;
	global.karakter_enerji_dusus = 0.17; //Karakter enerjisinin düşüş hızı
	global.karakter_enerji_dolma = 0.08; //Karakter enerjisinin dolum hızı
}